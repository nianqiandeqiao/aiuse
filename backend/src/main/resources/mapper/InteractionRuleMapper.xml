<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aiuse.medreminder.mapper.InteractionRuleMapper">

    <resultMap id="RuleMap" type="com.aiuse.medreminder.entity.InteractionRule">
        <id column="id" property="id"/>
        <result column="drug_a" property="drugA"/>
        <result column="drug_b" property="drugB"/>
        <result column="severity" property="severity"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="advice" property="advice"/>
        <result column="source" property="source"/>
        <result column="enabled" property="enabled"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <sql id="columns">
        id, drug_a, drug_b, severity, title, description, advice, source, enabled, created_at
    </sql>

    <select id="findAllEnabled" resultMap="RuleMap">
        SELECT <include refid="columns"/>
        FROM interaction_rule
        WHERE enabled = 1
        ORDER BY severity ASC, id ASC
    </select>

    <select id="findAll" resultMap="RuleMap">
        SELECT <include refid="columns"/>
        FROM interaction_rule
        ORDER BY severity ASC, id ASC
    </select>

    <select id="findById" resultMap="RuleMap">
        SELECT <include refid="columns"/>
        FROM interaction_rule
        WHERE id = #{id}
    </select>
</mapper>

