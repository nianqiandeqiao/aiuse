# build output
target/
*.class

# local secrets (never commit)
**/application-local.yml

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# frontend
node_modules/
dist/

# frontend build output (generated into backend static resources)
backend/src/main/resources/static/

# logs & temp
*.log
*.tmp

# local tools (cloudflared for public sharing)
tools/

# self-signed certificate (not used in LAN mode; kept ignored in case of local experiments)
backend/keystore.p12

# 服务器部署时生成的配置（含数据库密码与百度密钥）
.env
